# Public Supabase project values. Safe for browser use only when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required to identify this application to MusicBrainz.
MUSICBRAINZ_CONTACT=you@example.com

# Optional provider integrations. Keep server-side.
DISCOGS_TOKEN=
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://api.openai.com/v1
AI_VISION_MODEL=gpt-4.1-mini

# Public deployment origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
